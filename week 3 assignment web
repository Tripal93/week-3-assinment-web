<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Budget Tracker</title>
    <!-- Google Fonts Integration -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header id="main-header">
        <div class="header-content">
            <img src="https://via.placeholder.com/50" alt="Budget Tracker Logo" width="50" class="logo">
            <h1>My Budget Tracker</h1>
        </div>
        <p class="subtitle">Track your income and expenses in one place.</p>
    </header>

    <main>
        <!-- Add Expense Form -->
        <section id="add-expense-section" class="card">
            <h2>Add Expense</h2>
            <form>
                <div class="input-group">
                    <label for="expense-name">Expense Name</label>
                    <input type="text" id="expense-name" placeholder="e.g., Groceries">
                </div>
                <div class="input-group">
                    <label for="expense-amount">Amount ($)</label>
                    <input type="number" id="expense-amount" placeholder="0.00">
                </div>
                <div class="input-group">
                    <label for="expense-category">Category</label>
                    <select id="expense-category">
                        <option value="food">Food</option>
                        <option value="transport">Transport</option>
                        <option value="rent">Rent</option>
                        <option value="entertainment">Entertainment</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <button type="button" class="btn">Add Expense</button>
            </form>
        </section>

        <!-- Interactive Element -->
        <section class="card">
            <details>
                <summary>How to use this tracker</summary>
                <p>Fill out the expense name, amount, and choose a category from the dropdown above, then click 'Add Expense' to log it into your history.</p>
            </details>
        </section>

        <!-- Expense Table -->
        <section id="expenses-list-section" class="card expenses-section">
            <h2>Your Expenses</h2>
            <table class="expense-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Groceries</td>
                        <td>$45.50</td>
                        <td>Food</td>
                        <td>2026-10-01</td>
                    </tr>
                    <tr>
                        <td>Bus Pass</td>
                        <td>$30.00</td>
                        <td>Transport</td>
                        <td>2026-10-02</td>
                    </tr>
                    <tr>
                        <td>Apartment Rent</td>
                        <td>$850.00</td>
                        <td>Rent</td>
                        <td>2026-10-01</td>
                    </tr>
                    <tr>
                        <td>Movie Ticket</td>
                        <td>$15.00</td>
                        <td>Entertainment</td>
                        <td>2026-10-02</td>
                    </tr>
                    <tr>
                        <td>Coffee</td>
                        <td>$4.50</td>
                        <td>Food</td>
                        <td>2026-10-02</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <!-- Multimedia (YouTube Video Embed) -->
        <section class="card video-section">
            <h2>Budgeting Tips</h2>
            <iframe width="100%" height="315" src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="Budgeting Tips Video" frameborder="0" allowfullscreen></iframe>
        </section>
    </main>
</body>
</html>/* CSS Variables & Theme Definition */
:root {
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --bg-color: #f8fafc;
    --card-bg: #ffffff;
    --text-main: #1e293b;
    --text-muted: #64748b;
    --border-color: #cbd5e1;
    --header-bg: #0f172a;
}

/* Global Reset & Box-Sizing */
* {
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
    line-height: 1.5;
    margin: 0;
    padding: 20px;
}

/* Header Styling */
#main-header {
    text-align: center;
    margin-bottom: 30px;
}

#main-header h1 {
    color: var(--header-bg);
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 5px;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
}

.logo {
    border-radius: 50%;
}

.subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
}

/* Card Styling */
.card {
    background-color: var(--card-bg);
    border-radius: 12px;
    padding: 24px;
    margin: 20px auto;
    max-width: 600px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
}

.card h2 {
    font-size: 1.3rem;
    color: var(--header-bg);
    margin-top: 0;
    margin-bottom: 16px;
}

/* Form Styling */
.input-group {
    margin-bottom: 16px;
}

.input-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text-main);
}

#add-expense-section > form input:not([type="submit"]), 
#add-expense-section > form select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 1rem;
    font-family: 'Inter', sans-serif;
}

input:focus, select:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}

.btn {
    background-color: var(--primary-color);
    color: white;
    padding: 12px 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    width: 100%;
    transition: background-color 0.2s ease;
}

.btn:hover {
    background-color: var(--primary-hover);
}

/* Table Styling */
.expense-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
}

.expense-table th, 
.expense-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
    font-size: 0.95rem;
}

.expense-table th {
    background-color: #f1f5f9;
    color: var(--header-bg);
    font-weight: 600;
}

.expenses-section tr:nth-child(even) {
    background-color: #f8fafc;
}

.expenses-section tr:hover {
    background-color: #f1f5f9;
}

/* Details & Summary */
details {
    cursor: pointer;
    color: var(--text-main);
}

details summary {
    font-weight: 600;
}

details p {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 0.95rem;
}
